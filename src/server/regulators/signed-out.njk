{% extends 'layouts/page.njk' %}
{% block content %}
  {{ appHeading({
    text: heading,
    caption: ""
  }) }}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body" data-testid="signed-out-message">{{ message }}</p>
    </div>
  </div>
{% endblock %}
{% block bodyEnd %}
  <script>
    try {
      localStorage.setItem('regulator-auth-revoked', String(Date.now()))
    } catch (e) {}
  </script>
  {{ super() }}
{% endblock %}